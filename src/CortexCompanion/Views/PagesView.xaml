<UserControl x:Class="CortexCompanion.Views.PagesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:localization="clr-namespace:CortexCompanion.Localization"
 xmlns:viewModels="clr-namespace:CortexCompanion.ViewModels"
 xmlns:models="clr-namespace:CortexCompanion.Models"
 xmlns:accessibility="clr-namespace:CortexCompanion.Accessibility">
 <UserControl.InputBindings><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelSelectionPreparationCommand}"/></UserControl.InputBindings>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="{StaticResource MarginSectionBottom}">
        <StackPanel Visibility="{Binding IsPreparingSelection, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{StaticResource MarginStackItem}">
            <TextBlock Text="{x:Static localization:UiStrings.SourcesPreparingReview}" TextWrapping="Wrap" />
            <Button Content="{x:Static localization:UiStrings.ManageCancel}" Command="{Binding CancelSelectionPreparationCommand}" AutomationProperties.Name="{x:Static localization:UiStrings.ManageCancel}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
        </StackPanel>
   <TextBlock Text="{Binding ErrorContext}" FontWeight="SemiBold" Visibility="{Binding HasSourceError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   <TextBlock Text="{Binding StateMessage}" TextWrapping="Wrap" Margin="{StaticResource MarginSectionBottom}" AutomationProperties.LiveSetting="Polite" accessibility:LiveRegionBehavior.Announcement="{Binding StateMessage}"/>
   <WrapPanel Visibility="{Binding HasSourceError, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Button Content="{x:Static localization:UiStrings.SourcesRetry}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesRetry}" Command="{Binding RetrySourceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="{StaticResource MarginInlineSm}"/>
    <Button Content="{x:Static localization:UiStrings.SourcesReconnect}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesReconnect}" Command="{Binding ReconnectSourceCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
    <Button Content="{x:Static localization:UiStrings.SourcesViewDetails}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesViewDetails}" Click="ShowSourceDetailsClick" Style="{StaticResource SecondaryButtonStyle}"/>
   </WrapPanel>
  </StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <TextBlock Text="{x:Static localization:UiStrings.FlowSources}" Style="{StaticResource PageTitleStyle}"/>
   <TextBlock Text="{Binding DataContext.DocumentsStatus, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
    <Button Content="{x:Static localization:UiStrings.ExperienceUpdate}" AutomationProperties.Name="{x:Static localization:UiStrings.ExperienceUpdate}" Command="{Binding DataContext.UpdateDocumentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{x:Static localization:UiStrings.SourcesApplyHelp}" Style="{StaticResource PrimaryButtonStyle}" Margin="{StaticResource MarginInlineSm}"/>
   <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
    <StackPanel>
     <TextBlock Text="{x:Static localization:UiStrings.ExperienceLocal}" FontWeight="SemiBold" />
     <TextBlock Text="{Binding DataContext.LocalSourcePath, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
     <TextBlock Text="{x:Static localization:UiStrings.HomeIndex}" Foreground="{DynamicResource TextSecondaryBrush}" />
     <TextBlock Text="{Binding DataContext.Sync.Freshness.LastIndex, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
     <Button Content="{x:Static localization:UiStrings.ExperienceEditFolder}" AutomationProperties.Name="{x:Static localization:UiStrings.ExperienceEditFolder}"
             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static models:NavigationPage.Settings}"
             Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="{StaticResource MarginSectionTop}" />
    </StackPanel>
   </Border>
   <TextBlock Text="{x:Static localization:UiStrings.ExperienceConfluence}" FontWeight="SemiBold" Margin="{StaticResource MarginStackItem}" />
   <TextBlock Text="{x:Static localization:UiStrings.ManageHelp}" TextWrapping="Wrap"/>
   <WrapPanel Margin="{StaticResource MarginSectionTop}">
    <Button Content="{x:Static localization:UiStrings.SourcesAdd}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesAdd}" Command="{Binding ShowAddSourceCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="{StaticResource MarginInlineSm}"/>

    <Button Content="{x:Static localization:UiStrings.SourcesUndo}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesUndo}" Command="{Binding UndoRemovalCommand}" Visibility="{Binding CanUndoRemoval, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{x:Static localization:UiStrings.SourcesUndoHelp}" Style="{StaticResource SecondaryButtonStyle}"/>
     <Button Content="{x:Static localization:UiStrings.ManageRefresh}" AutomationProperties.Name="{x:Static localization:UiStrings.ManageRefresh}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="{StaticResource MarginStackItem}"/>
   </WrapPanel>
   <TextBlock Text="{x:Static localization:UiStrings.SourcesSearch}" Margin="{StaticResource MarginSectionTop}"/>
   <TextBox Text="{Binding SourceSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesSearch}" Margin="{StaticResource MarginStackItem}"/>
   <TextBlock Text="{x:Static localization:UiStrings.SourcesEmpty}" TextWrapping="Wrap" Visibility="{Binding HasNoSources, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   <TextBlock Text="{x:Static localization:UiStrings.SourcesNoMatch}" TextWrapping="Wrap" Visibility="{Binding NoMatchingSources, Converter={StaticResource BooleanToVisibilityConverter}}"/>

    <StackPanel Margin="{StaticResource MarginSectionTop}">

            <ItemsControl ItemsSource="{Binding VisibleSpaces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ConfiguredSpaceViewModel}">
                        <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginCardBottom}">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.SourceReadiness, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="SemiBold" Margin="{StaticResource MarginStackItem}" AutomationProperties.LiveSetting="Polite"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SpaceKey}"
                                               FontSize="{StaticResource FontSizeTitle}"
                                               FontWeight="SemiBold" />
                                    <Button Grid.Column="1"
                                            Content="{x:Static localization:UiStrings.ManageEdit}"
                                            AutomationProperties.Name="{x:Static localization:UiStrings.ManageEdit}"
                                            Command="{Binding DataContext.EditSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <WrapPanel Margin="{StaticResource MarginStackItem}">
                                    <Button Content="{x:Static localization:UiStrings.ManageOpen}" AutomationProperties.Name="{x:Static localization:UiStrings.ManageOpen}" Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Margin="{StaticResource MarginInlineSm}"/>
                                    <Button Content="{x:Static localization:UiStrings.ManageRemove}" AutomationProperties.Name="{x:Static localization:UiStrings.ManageRemove}" Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Margin="{StaticResource MarginInlineSm}"/>
                                </WrapPanel>
                                <WrapPanel Margin="{StaticResource MarginDetailRow}">
                                    <TextBlock Text="{Binding ModeSummary}"
                                               FontWeight="SemiBold"
                                               Margin="{StaticResource MarginInlineControlSpaced}" />
                                    <TextBlock Text="{Binding ClassificationSummary}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectionDescription}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="{StaticResource MarginStackItem}" />
                                <Border Background="{DynamicResource WarningBrush}"
                                        Padding="{StaticResource SpacingSm}"
                                        Margin="{StaticResource MarginStackItem}"
                                        Visibility="{Binding HasScopeWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ScopeWarning}"
                                                   Foreground="{DynamicResource BackgroundBrush}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <Button Content="{x:Static localization:UiStrings.ManageEdit}"
                                                AutomationProperties.Name="{x:Static localization:UiStrings.ManageEdit}"
                                                Command="{Binding DataContext.EditSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Left"
                                                Margin="{StaticResource MarginSectionTop}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding CoverageSummary}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="{StaticResource MarginStackItem}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static localization:UiStrings.PagesEmptySelection}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontWeight="SemiBold"
                                           Margin="{StaticResource MarginStackItem}"
                                           Visibility="{Binding IsEmptyPagesSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ItemsControl ItemsSource="{Binding Pages}"
                                              Visibility="{Binding IsPagesSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ConfiguredPageViewModel}">
                                            <Border Background="{DynamicResource HighlightBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="{StaticResource BorderThin}"
                                                    Padding="{StaticResource SpacingMd}"
                                                    Margin="{StaticResource MarginStackItem}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding TitleProvenance}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="{StaticResource FontSizeCaption}" />
                                                        <TextBlock Text="{Binding PageIdSummary}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                    <Button Content="{x:Static localization:UiStrings.ManageOpen}" AutomationProperties.Name="{x:Static localization:UiStrings.ManageOpen}" Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Margin="{StaticResource MarginStackItem}"/>
                                                    <Button
                                                            Content="{x:Static localization:UiStrings.PagesRemove}"
                                                            AutomationProperties.Name="{x:Static localization:UiStrings.PagesRemove}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

    </StackPanel>
   <Expander x:Name="AddSourcePanel" Header="{Binding SourceFormTitle}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesAdd}" IsExpanded="{Binding ShowAddSource, Mode=TwoWay}" Expanded="AddSourceExpanded" Margin="{StaticResource MarginSectionBottom}">
    <StackPanel>
   <TextBlock Text="{Binding SourceFormHelp}" TextWrapping="Wrap" Margin="{StaticResource MarginSectionBottom}"/>
   <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
    <StackPanel IsEnabled="{Binding CanEditSource}">
     <StackPanel Visibility="{Binding ShowSourceLink, Converter={StaticResource BooleanToVisibilityConverter}}">
     <TextBlock x:Name="SourceUrlLabel" Text="{x:Static localization:UiStrings.FlowLink}" Margin="{StaticResource MarginLabelBottom}"/>
     <TextBox x:Name="SourceLinkInput" Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=SourceUrlLabel}" Margin="{StaticResource MarginStackItem}">
      <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding InspectSourceCommand}"/></TextBox.InputBindings>
     </TextBox>
     <TextBlock Text="{Binding SourceIdentity}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}"/>
     <StackPanel Visibility="{Binding NeedsSpaceKey, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{x:Static localization:UiStrings.FlowSpaceHelp}" TextWrapping="Wrap"/>
      <TextBox Text="{Binding SetupSpaceKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static localization:UiStrings.PagesSetupSpaceKeyLabel}" Margin="{StaticResource MarginStackItem}"/>
     </StackPanel>
     <StackPanel Visibility="{Binding ShowSourceClassification, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{x:Static localization:UiStrings.PagesSetupClassificationLabel}" Margin="{StaticResource MarginLabelBottom}"/>
      <ComboBox ItemsSource="{Binding ClassificationOptions}" SelectedItem="{Binding SelectedClassification}" DisplayMemberPath="DisplayName" AutomationProperties.Name="{x:Static localization:UiStrings.PagesSetupClassificationLabel}" Margin="{StaticResource MarginStackItem}"/>
      <TextBlock Text="{x:Static localization:UiStrings.FlowClassificationHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="{StaticResource MarginSectionBottom}"/>
     </StackPanel>
     </StackPanel>
     <StackPanel Visibility="{Binding ShowSourceDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock Text="{x:Static localization:UiStrings.PagesSetupExpiryLabel}" Margin="{StaticResource MarginLabelBottom}"/>
      <DatePicker SelectedDate="{Binding SetupExpiryDate}" AutomationProperties.Name="{x:Static localization:UiStrings.PagesSetupExpiryLabel}" Margin="{StaticResource MarginStackItem}"/>
      <TextBlock Text="{x:Static localization:UiStrings.FlowToken}" Margin="{StaticResource MarginLabelBottom}"/>
      <PasswordBox x:Name="SourcePatInput" AutomationProperties.Name="{x:Static localization:UiStrings.FlowToken}" KeyDown="SourcePatKeyDown" Margin="{StaticResource MarginStackItem}"/>
      <Expander Header="{x:Static localization:UiStrings.FlowTokenHelp}" AutomationProperties.Name="{x:Static localization:UiStrings.FlowTokenHelp}" Margin="{StaticResource MarginStackItem}">
       <TextBlock Text="{x:Static localization:UiStrings.FlowTokenInstructions}" TextWrapping="Wrap" Margin="{StaticResource MarginSectionTop}"/>
      </Expander>
      <Button Content="{x:Static localization:UiStrings.FlowConnect}" AutomationProperties.Name="{x:Static localization:UiStrings.FlowConnect}" Click="StoreSourceCredentialClick" IsEnabled="{Binding DataContext.Settings.CanStoreConfluenceCredential, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="{StaticResource MarginStackItem}"/>
      <TextBlock Text="{Binding DataContext.Settings.ConfluenceCredentialStateText, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}"/>
     </StackPanel>
     <Button Visibility="{Binding ShowSourceLink, Converter={StaticResource BooleanToVisibilityConverter}}" Content="{x:Static localization:UiStrings.FlowInspect}" AutomationProperties.Name="{x:Static localization:UiStrings.FlowInspect}" Command="{Binding InspectSourceCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
    </StackPanel>
   </Expander>
   <Expander Header="{x:Static localization:UiStrings.FlowAdvanced}" AutomationProperties.Name="{x:Static localization:UiStrings.FlowAdvanced}">
    <StackPanel Margin="{StaticResource MarginSectionTop}">
     <TextBlock Text="{x:Static localization:UiStrings.PagesSetupConverterHint}" TextWrapping="Wrap"/>
     <TextBox Text="{Binding SetupConverterPath}" AutomationProperties.Name="{x:Static localization:UiStrings.PagesSetupConverterLabel}" Margin="{StaticResource MarginStackItem}"/>
     <Button Content="{x:Static localization:UiStrings.PagesSetupBrowse}" AutomationProperties.Name="{x:Static localization:UiStrings.PagesSetupBrowse}" Command="{Binding BrowseConverterCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
            <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginCardBottom}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.ConfigPathLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ConfigPath}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding ConfigOriginSummary}" TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding HasOverrides, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Static localization:UiStrings.EnvironmentOverridesTitle}"
                                   FontWeight="SemiBold"
                                   Margin="{StaticResource MarginBlockAbove}" />
                        <ItemsControl ItemsSource="{Binding Overrides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:EnvironmentOverrideViewModel}">
                                <Border Background="{DynamicResource HighlightBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="{StaticResource BorderThin}"
                                        Padding="{StaticResource SpacingSm}"
                                        Margin="{StaticResource MarginStackItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource PageDetailLabelWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DisplayOrigin}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       FontSize="{StaticResource FontSizeCaption}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>


    </StackPanel>
   </Expander>
  </StackPanel>
 </ScrollViewer>
 </Grid>
</UserControl>
