<UserControl x:Class="CortexCompanion.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localization="clr-namespace:CortexCompanion.Localization" xmlns:models="clr-namespace:CortexCompanion.Models" xmlns:accessibility="clr-namespace:CortexCompanion.Accessibility">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshOverviewCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{x:Static localization:UiStrings.HomeTitle}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontSize="{StaticResource FontSizeHeadline}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static localization:UiStrings.HomeIntro}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
            <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <TextBlock Text="{Binding Sync.Freshness.Status}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontWeight="SemiBold" />
                    <Button Content="{Binding RecommendedAction}" AutomationProperties.Name="{Binding RecommendedAction}" Command="{Binding ContinueSetupCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <UniformGrid Columns="2">
                    <StackPanel Margin="{StaticResource MarginInlineSm}">
                    <TextBlock Text="{x:Static localization:UiStrings.HomeIndex}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Sync.Freshness.LastIndex}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    </StackPanel>
                    <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.HomeCollection}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Sync.LastSuccess}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    </StackPanel>
                    <StackPanel Margin="{StaticResource MarginInlineSm}">
                    <TextBlock Text="{x:Static localization:UiStrings.HomeNext}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Scheduling.NextRunText}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding Scheduling.StateText}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    </StackPanel>
                    <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.HomeActivity}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Sync.RunResult}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding Sync.ProgressText}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    </StackPanel>
                    </UniformGrid>
                    <Button Content="{x:Static localization:UiStrings.HomeRefresh}" AutomationProperties.Name="{x:Static localization:UiStrings.HomeRefresh}" Command="{Binding RefreshOverviewCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Expander Header="{x:Static localization:UiStrings.GuideTitle}" AutomationProperties.Name="{x:Static localization:UiStrings.GuideTitle}" IsExpanded="{Binding IsGuideExpanded, Mode=TwoWay}" Margin="{StaticResource MarginSectionBottom}">
                <StackPanel Margin="{StaticResource MarginSectionTop}">
                    <TextBlock Text="{x:Static localization:UiStrings.GuideIntro}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.GuideDocuments}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SetupConfigurationState}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                            <Button Content="{x:Static localization:UiStrings.GuideConfigure}" AutomationProperties.Name="{x:Static localization:UiStrings.GuideConfigure}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Settings}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="{StaticResource MarginStackItem}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.GuideConfluence}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static localization:UiStrings.GuideConfluenceHelp}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                            <Button Content="{x:Static localization:UiStrings.PagesNavigation}" AutomationProperties.Name="{x:Static localization:UiStrings.PagesNavigation}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.ConfluencePages}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="{StaticResource MarginStackItem}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.GuideIndex}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SetupIndexState}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                            <Button Content="{x:Static localization:UiStrings.GuideSync}" AutomationProperties.Name="{x:Static localization:UiStrings.GuideSync}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.LocalKnowledgeBase}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="{StaticResource MarginStackItem}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.GuideTry}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static localization:UiStrings.GuideTryHelp}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                            <Button Content="{x:Static localization:UiStrings.GuideSearch}" AutomationProperties.Name="{x:Static localization:UiStrings.GuideSearch}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static models:NavigationPage.Search}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="{StaticResource MarginStackItem}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
            <Border Style="{StaticResource PageCardStyle}" Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.UpdateTitle}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static localization:UiStrings.UpdateCompanion}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding Updates.CompanionVersion}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.UpdateCortex}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding Updates.CortexVersion}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.UpdateAvailableLabel}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding Updates.AvailableVersion}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding Updates.Status}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" AutomationProperties.LiveSetting="Polite" accessibility:LiveRegionBehavior.Announcement="{Binding Updates.Status}" />
                    <TextBlock Text="{x:Static localization:UiStrings.UpdateHelp}" TextWrapping="Wrap" Margin="{StaticResource MarginStackItem}" />
                    <WrapPanel>
                        <Button Content="{x:Static localization:UiStrings.UpdateCheck}" AutomationProperties.Name="{x:Static localization:UiStrings.UpdateCheck}" Command="{Binding Updates.CheckCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="{StaticResource MarginInlineField}" />
                        <Button Content="{x:Static localization:UiStrings.UpdateOpen}" AutomationProperties.Name="{x:Static localization:UiStrings.UpdateOpen}" Command="{Binding Updates.OpenReleaseCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="{StaticResource MarginInlineField}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
