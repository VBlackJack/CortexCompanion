<Window x:Class="CortexCompanion.Views.TypedConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:CortexCompanion.Localization"
        Title="{x:Static localization:UiStrings.ConfirmModeTitle}"
        Width="520"
        Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}">
    <Grid Margin="{StaticResource SpacingXl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   Margin="{StaticResource MarginSectionBottom}" />
        <TextBlock Grid.Row="1"
                   Text="{x:Static localization:UiStrings.ConfirmModeInputLabel}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox x:Name="ConfirmationInput"
                 Grid.Row="2"
                 Margin="0,8,0,16"
                 MinHeight="{StaticResource ControlMinHeight}"
                 Padding="{StaticResource SpacingSm}"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static localization:UiStrings.CancelButton}"
                    Click="CancelClick"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Content="{x:Static localization:UiStrings.ConfirmButton}"
                    Click="ConfirmClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
