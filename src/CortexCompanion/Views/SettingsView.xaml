<UserControl x:Class="CortexCompanion.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accessibility="clr-namespace:CortexCompanion.Accessibility"
             xmlns:localization="clr-namespace:CortexCompanion.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}"
                    HorizontalAlignment="Left">
            <TextBlock Text="{x:Static localization:UiStrings.SettingsTitle}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Static localization:UiStrings.SettingsIntroduction}"
                       Style="{StaticResource PlaceholderTextStyle}"
                       Margin="{StaticResource MarginSectionSeparator}" />

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.SettingsCurrentStateTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginLabelBottom}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               accessibility:LiveRegionBehavior.Announcement="{Binding StatusMessage}"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.SettingsCliTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.SettingsCliDescription}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock x:Name="CliPathLabel"
                               Text="{x:Static localization:UiStrings.SettingsCliPathLabel}"
                               Margin="{StaticResource MarginLabelBottom}" />
                    <Grid Margin="{StaticResource MarginStackItem}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CliPath, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=CliPathLabel}" />
                        <Button Grid.Column="1"
                                Content="{x:Static localization:UiStrings.BrowseButton}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.SettingsBrowseCliAccessibleName}"
                                Command="{Binding BrowseCliCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="{StaticResource MarginInlineControl}" />
                    </Grid>
                    <TextBlock Text="{Binding CliValidationMessage}"
                               accessibility:LiveRegionBehavior.Announcement="{Binding CliValidationMessage}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="{StaticResource MarginStackItem}" />
                    <Button Content="{x:Static localization:UiStrings.SettingsSaveAndConnect}"
                            AutomationProperties.Name="{x:Static localization:UiStrings.SettingsSaveAndConnect}"
                            Command="{Binding SaveCliCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}"
                    IsEnabled="{Binding IsCliReady}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.SettingsKnowledgeBaseTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.SettingsKnowledgeBaseDescription}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding ConfigStateText}"
                               accessibility:LiveRegionBehavior.Announcement="{Binding ConfigStateText}"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock x:Name="KnowledgeBasePathLabel"
                               Text="{x:Static localization:UiStrings.SettingsKnowledgeBasePathLabel}"
                               Margin="{StaticResource MarginLabelBottom}" />
                    <Grid Margin="{StaticResource MarginStackItem}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding KnowledgeBasePath, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=KnowledgeBasePathLabel}" />
                        <Button Grid.Column="1"
                                Content="{x:Static localization:UiStrings.BrowseButton}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.SettingsBrowseKnowledgeBaseAccessibleName}"
                                Command="{Binding BrowseKnowledgeBaseCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="{StaticResource MarginInlineControl}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Static localization:UiStrings.SettingsSaveKnowledgeBase}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.SettingsSaveKnowledgeBase}"
                                Command="{Binding SaveKnowledgeBaseCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="{StaticResource MarginInlineSm}" />
                        <Button Content="{x:Static localization:UiStrings.RefreshButton}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.SettingsRefreshAccessibleName}"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
