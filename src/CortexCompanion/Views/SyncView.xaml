<UserControl x:Class="CortexCompanion.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:CortexCompanion.Localization"
             xmlns:viewModels="clr-namespace:CortexCompanion.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="{StaticResource MarginHeadingBottom}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static localization:UiStrings.SyncTitle}"
                           Style="{StaticResource PageTitleStyle}" />
                <Button Grid.Column="1"
                        Content="{x:Static localization:UiStrings.SyncRefresh}"
                        AutomationProperties.Name="{x:Static localization:UiStrings.SyncRefresh}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border Background="{DynamicResource WarningBrush}"
                    Padding="{StaticResource SpacingSm}"
                    Margin="{StaticResource MarginSectionBottom}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{x:Static localization:UiStrings.SyncReadOnly}"
                           Foreground="{DynamicResource BackgroundBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <WrapPanel Margin="{StaticResource MarginStackItem}">
                        <Button Content="{x:Static localization:UiStrings.SyncNow}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.SyncNow}"
                                Command="{Binding SyncCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="{x:Static localization:UiStrings.StoreCredential}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.StoreCredential}"
                                Command="{Binding StoreCredentialCommand}"
                                Margin="{StaticResource SpacingSm}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StateMessage}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.SyncHealthPathTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.SyncHealthPathLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding HealthPath}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.SyncHealthPathOriginLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding HealthPathOrigin}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.SyncHealthTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <UniformGrid Columns="2">
                        <TextBlock Text="{x:Static localization:UiStrings.SyncHealthStatusLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding HealthStatus}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncLastAttemptLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LastAttempt}" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncLastSuccessLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LastSuccess}" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncErrorCodeLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ErrorCode}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncActionRequiredLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ActionRequired}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncSeenLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Seen}" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncConvertedLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Converted}" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncFailedLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Failed}" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncCarryForwardLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CarryForward}" />
                        <TextBlock Text="{x:Static localization:UiStrings.SyncTombstonesLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Tombstones}" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.PatTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.PatStatusLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PatStatus}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.PatOriginLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PatOrigin}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}"
                    Visibility="{Binding HasOverrides, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.EnvironmentOverridesTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <ItemsControl ItemsSource="{Binding Overrides}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:EnvironmentOverrideViewModel}">
                                <Border Background="{DynamicResource HighlightBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="{StaticResource SpacingSm}"
                                        Margin="{StaticResource MarginStackItem}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DisplayOrigin}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PageCardStyle}">
                <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.SyncRunTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.SyncRunResultLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding RunResult}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.SyncDiagnosticsLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding StandardError, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsReturn="True"
                             MinHeight="{StaticResource ControlMinHeight}"
                             Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.SyncFinalOutputLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding StandardOutput, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsReturn="True"
                             MinHeight="{StaticResource ControlMinHeight}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
