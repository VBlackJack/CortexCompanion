<UserControl x:Class="CortexCompanion.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accessibility="clr-namespace:CortexCompanion.Accessibility"
             xmlns:localization="clr-namespace:CortexCompanion.Localization"
             xmlns:viewModels="clr-namespace:CortexCompanion.ViewModels">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="{StaticResource MarginHeadingBottom}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static localization:UiStrings.SyncTitle}"
                           Style="{StaticResource PageTitleStyle}" />
                <Button Grid.Column="1"
                        Content="{x:Static localization:UiStrings.SyncRefresh}"
                        AutomationProperties.Name="{x:Static localization:UiStrings.SyncRefresh}"
                        ToolTip="{x:Static localization:UiStrings.ShortcutRefreshHint}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border Background="{DynamicResource WarningBrush}"
                    Padding="{StaticResource PaddingAlertBanner}"
                    Margin="{StaticResource MarginSectionBottom}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{x:Static localization:UiStrings.SyncReadOnly}"
                           Foreground="{DynamicResource BackgroundBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource PageCardStyle}"
                    Margin="{StaticResource MarginSectionBottom}">
                <StackPanel>
                    <TextBlock Text="{Binding RunTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{x:Static localization:UiStrings.LocalSyncDescription}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <WrapPanel Margin="{StaticResource MarginStackItem}">
                        <Button Content="{x:Static localization:UiStrings.SyncNow}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.SyncNow}"
                                Command="{Binding SyncCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="{StaticResource MarginInlineSm}" />
                        <Button Content="{x:Static localization:UiStrings.ConfluenceSyncNow}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.ConfluenceSyncNow}"
                                Command="{Binding ConfluenceSyncCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="{StaticResource MarginInlineSm}" />
                        <Button Content="{x:Static localization:UiStrings.SyncCancel}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.SyncCancel}"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanCancelRun, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StateMessage}"
                               accessibility:LiveRegionBehavior.Announcement="{Binding StateMessage}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="{StaticResource MarginStackItem}" />
                    <TextBlock Text="{Binding RunResult}"
                               accessibility:LiveRegionBehavior.Announcement="{Binding RunResult}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Assertive" />
                    <StackPanel Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="{StaticResource MarginSectionTop}">
                        <TextBlock Text="{Binding ProgressText}"
                                   AutomationProperties.LiveSetting="Polite"
                                   accessibility:LiveRegionBehavior.Announcement="{Binding ProgressText}"
                                   FontWeight="SemiBold" />
                        <ProgressBar Minimum="0"
                                     Maximum="{Binding ProgressMaximum}"
                                     Value="{Binding ProgressCurrent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Height="{StaticResource ProgressBarHeight}"
                                     Margin="{StaticResource MarginStackItem}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander Header="{x:Static localization:UiStrings.ConfluenceSyncAdvancedTitle}"
                      AutomationProperties.Name="{x:Static localization:UiStrings.ConfluenceSyncAdvancedTitle}"
                      IsExpanded="False"
                      Margin="{StaticResource MarginSectionBottom}">
                <StackPanel Margin="{StaticResource MarginSectionTop}">
                    <TextBlock Text="{x:Static localization:UiStrings.ConfluenceSyncAdvancedDescription}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <WrapPanel Margin="{StaticResource MarginStackItem}">
                        <Button Content="{x:Static localization:UiStrings.StoreCredential}"
                                AutomationProperties.Name="{x:Static localization:UiStrings.StoreCredential}"
                                Command="{Binding StoreCredentialCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.ConfluenceSyncForceHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="{StaticResource MarginStackItem}" />
                    <Border Style="{StaticResource PageCardStyle}">
                        <StackPanel>
                    <TextBlock Text="{x:Static localization:UiStrings.SyncHealthTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="{StaticResource MarginStackItem}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Static localization:UiStrings.SyncHealthStatusLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="{StaticResource MarginInlineSm}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HealthStatus}"
                                   accessibility:LiveRegionBehavior.Announcement="{Binding HealthStatus}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Grid.Row="1"
                                   Text="{x:Static localization:UiStrings.SyncActionRequiredLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="{StaticResource MarginInlineSm}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding ActionRequired}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2"
                                   Text="{x:Static localization:UiStrings.SyncLastAttemptLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="{StaticResource MarginInlineSm}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastAttempt}" />
                        <TextBlock Grid.Row="3"
                                   Text="{x:Static localization:UiStrings.SyncLastSuccessLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="{StaticResource MarginInlineSm}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastSuccess}" />
                    </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <Expander Header="{x:Static localization:UiStrings.SyncTechnicalDetails}"
                      AutomationProperties.Name="{x:Static localization:UiStrings.SyncTechnicalDetails}"
                      IsExpanded="False">
                <StackPanel Margin="{StaticResource MarginSectionTop}">
                    <Border Style="{StaticResource PageCardStyle}"
                            Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.SyncHealthPathTitle}"
                                       FontWeight="SemiBold"
                                       Margin="{StaticResource MarginStackItem}" />
                            <TextBlock Text="{Binding HealthPath}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HealthPathOrigin}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource MarginSectionTop}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}"
                            Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.IngestionStorageTitle}"
                                       FontWeight="SemiBold"
                                       Margin="{StaticResource MarginStackItem}" />
                            <TextBlock Text="{Binding StorageSummary}" TextWrapping="Wrap" />
                            <Button Content="{x:Static localization:UiStrings.OpenCurrentGeneration}"
                                    AutomationProperties.Name="{x:Static localization:UiStrings.OpenCurrentGeneration}"
                                    Command="{Binding OpenCurrentGenerationCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="{StaticResource MarginSectionTop}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}"
                            Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.SyncDiagnosticsSummaryTitle}"
                                       FontWeight="SemiBold"
                                       Margin="{StaticResource MarginStackItem}" />
                            <UniformGrid Columns="2">
                                <TextBlock Text="{x:Static localization:UiStrings.SyncErrorCodeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ErrorCode}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static localization:UiStrings.SyncSeenLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Seen}" />
                                <TextBlock Text="{x:Static localization:UiStrings.SyncConvertedLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Converted}" />
                                <TextBlock Text="{x:Static localization:UiStrings.SyncFailedLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Failed}" />
                                <TextBlock Text="{x:Static localization:UiStrings.SyncCarryForwardLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CarryForward}" />
                                <TextBlock Text="{x:Static localization:UiStrings.SyncTombstonesLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Tombstones}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}"
                            Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.PatTitle}"
                                       FontWeight="SemiBold"
                                       Margin="{StaticResource MarginStackItem}" />
                            <TextBlock Text="{Binding PatStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PatOrigin}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource MarginSectionTop}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}"
                            Margin="{StaticResource MarginSectionBottom}"
                            Visibility="{Binding HasOverrides, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.EnvironmentOverridesTitle}"
                                       FontWeight="SemiBold"
                                       Margin="{StaticResource MarginStackItem}" />
                            <ItemsControl ItemsSource="{Binding Overrides}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:EnvironmentOverrideViewModel}">
                                        <Border Background="{DynamicResource HighlightBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="{StaticResource BorderThin}"
                                                Padding="{StaticResource SpacingSm}"
                                                Margin="{StaticResource MarginStackItem}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DisplayOrigin}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="{StaticResource FontSizeCaption}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PageCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{x:Static localization:UiStrings.SyncRawOutputTitle}"
                                       FontWeight="SemiBold"
                                       Margin="{StaticResource MarginStackItem}" />
                            <TextBlock Text="{x:Static localization:UiStrings.SyncDiagnosticsLanguageNote}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource MarginStackItem}" />
                            <TextBlock x:Name="StandardErrorLabel"
                                       Text="{x:Static localization:UiStrings.SyncDiagnosticsLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding StandardError, Mode=OneWay}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=StandardErrorLabel}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Disabled"
                                     AcceptsReturn="True"
                                     MinHeight="{StaticResource ControlMinHeight}"
                                     Margin="{StaticResource MarginStackItem}" />
                            <TextBlock x:Name="StandardOutputLabel"
                                       Text="{x:Static localization:UiStrings.SyncFinalOutputLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding StandardOutput, Mode=OneWay}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=StandardOutputLabel}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     HorizontalScrollBarVisibility="Disabled"
                                     AcceptsReturn="True"
                                     MinHeight="{StaticResource ControlMinHeight}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
