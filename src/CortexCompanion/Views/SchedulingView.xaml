<UserControl x:Class="CortexCompanion.Views.SchedulingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:CortexCompanion.Localization">
    <Border Style="{StaticResource PageCardStyle}">
        <StackPanel>
            <TextBlock Text="{x:Static localization:UiStrings.SchedulingTitle}"
                       Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Static localization:UiStrings.SchedulingPlaceholder}"
                       Style="{StaticResource PlaceholderTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>

