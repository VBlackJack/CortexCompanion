<Window x:Class="CortexCompanion.Views.SourceSelectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:viewModels="clr-namespace:CortexCompanion.ViewModels"
 xmlns:localization="clr-namespace:CortexCompanion.Localization"
 Width="{StaticResource ScopeDialogWidth}" Height="{StaticResource ScopeDialogMaxHeight}"
 ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
 FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontSizeBody}"
 Title="{x:Static localization:UiStrings.ManageEdit}">

 <Grid Margin="{StaticResource SpacingXl}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock x:Name="SourceTitle" Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap"/>
    <TextBlock Text="{x:Static localization:UiStrings.ManageScopeHelp}" TextWrapping="Wrap" Margin="{StaticResource MarginSectionBottom}"/>
    <RadioButton Foreground="{DynamicResource TextPrimaryBrush}" x:Name="PagesOption" Content="{x:Static localization:UiStrings.ManagePages}" GroupName="Selection" Margin="{StaticResource MarginChoiceBottom}" Checked="ScopeChanged"/>
    <RadioButton Foreground="{DynamicResource TextPrimaryBrush}" x:Name="SubtreeOption" Content="{x:Static localization:UiStrings.ManageSubtree}" GroupName="Selection" Margin="{StaticResource MarginChoiceBottom}" Checked="ScopeChanged"/>
    <RadioButton Foreground="{DynamicResource TextPrimaryBrush}" x:Name="WholeOption" Content="{x:Static localization:UiStrings.ManageWhole}" GroupName="Selection" Margin="{StaticResource MarginChoiceBottom}" Checked="ScopeChanged"/>
   </StackPanel>
    <Grid Grid.Row="1" x:Name="PageSelectionPanel" Margin="{StaticResource MarginSectionTop}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
     <Button x:Name="LoadTreeButton" Content="{x:Static localization:UiStrings.SourcesLoadTree}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesLoadTree}" Click="LoadTreeClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="{StaticResource MarginStackItem}"/>
     <TextBlock Text="{x:Static localization:UiStrings.SourcesTreeSearch}"/>
     <TextBox x:Name="TreeSearch" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesTreeSearch}" ToolTip="{x:Static localization:UiStrings.SourcesTreeSearch}" TextChanged="SearchChanged" Margin="{StaticResource MarginStackItem}"/>
     </StackPanel>
     <TreeView Grid.Row="1" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SourceTreeItemStyle}" x:Name="PageChoices" Background="{DynamicResource BackgroundBrush}" BorderThickness="{StaticResource BorderNone}" Foreground="{DynamicResource TextPrimaryBrush}">

      <TreeView.ItemTemplate><HierarchicalDataTemplate ItemContainerStyle="{StaticResource SourceTreeItemStyle}" DataType="{x:Type viewModels:SourceTreeNode}" ItemsSource="{Binding Children}">
       <StackPanel>
        <CheckBox Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}" Margin="{StaticResource MarginStackItem}"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></CheckBox>
        <TextBlock Text="{x:Static localization:UiStrings.SourcesCovered}" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding IsCovered, Converter={StaticResource BooleanToVisibilityConverter}}"/>
       </StackPanel>
      </HierarchicalDataTemplate></TreeView.ItemTemplate>
     </TreeView>
     <StackPanel Grid.Row="2">
     <TextBlock x:Name="LinkLabel" Text="{x:Static localization:UiStrings.ManageLink}" TextWrapping="Wrap" Margin="{StaticResource MarginSectionTop}"/>
     <TextBox x:Name="AdditionalLink" TextChanged="AdditionalLinkChanged" AutomationProperties.LabeledBy="{Binding ElementName=LinkLabel}" Margin="{StaticResource MarginStackItem}"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2">
    <TextBlock Text="{x:Static localization:UiStrings.ManageConsequences}" TextWrapping="Wrap" Margin="{StaticResource MarginSectionTop}"/>
    <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" AutomationProperties.LiveSetting="Polite" Margin="{StaticResource MarginSectionTop}"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1" Margin="{StaticResource MarginSectionTop}">
   <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" FontWeight="SemiBold" />
   <TextBlock x:Name="DraftSummary" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
  <WrapPanel x:Name="EditorActions" HorizontalAlignment="Right" Margin="{StaticResource MarginSectionTop}">
   <Button x:Name="CancelEditorButton" Click="CancelEditorClick" Content="{x:Static localization:UiStrings.ManageCancel}" AutomationProperties.Name="{x:Static localization:UiStrings.ManageCancel}" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="{StaticResource MarginInlineSm}"/>
   <Button x:Name="SaveLaterButton" Content="{x:Static localization:UiStrings.SourcesSaveLater}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesSaveLater}" Click="SaveLaterClick" Style="{StaticResource SecondaryButtonStyle}" Margin="{StaticResource MarginInlineSm}"/>
   <Button x:Name="SaveUpdateButton" Content="{x:Static localization:UiStrings.SourcesSaveUpdate}" AutomationProperties.Name="{x:Static localization:UiStrings.SourcesSaveUpdate}" Click="ReviewClick" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"/>
  </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
