# pre-push — Run the explicit C# declaration gate before Git sends objects.
# Usage: .githooks/pre-push [--help]

set -euo pipefail

readonly E_SUCCESS=0
readonly E_USAGE=1
readonly E_MISSING_DEP=2

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LOG_VERBOSE="${LOG_VERBOSE:-false}"

log_info() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO]  $*"; }
log_error() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $*" >&2; }
log_success() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [OK]    $*"; }

cleanup() {
    local exit_code=$?
    if [[ "${exit_code}" -ne "${E_SUCCESS}" ]]; then
        log_error "Pre-push gate failed with exit code ${exit_code}"
    fi
}
trap cleanup EXIT

usage() {
    echo "Usage: $(basename "$0") [--help]"
    echo "Runs the repository C# explicit-type gate."
}

main() {
    if [[ "${1:-}" == "--help" ]]; then
        usage
        exit "${E_SUCCESS}"
    fi
    if [[ $# -gt 0 ]]; then
        log_error "Unknown option: $1"
        usage
        exit "${E_USAGE}"
    fi
    if ! command -v pwsh >/dev/null 2>&1; then
        log_error "pwsh is required to run the C# style gate."
        exit "${E_MISSING_DEP}"
    fi

    [[ "${LOG_VERBOSE}" == "true" ]] && log_info "Project root: ${PROJECT_ROOT}"
    log_info "Running explicit C# type gate"
    pwsh -NoLogo -NoProfile -File "${PROJECT_ROOT}/tools/ci-csharp-style.ps1"
    log_success "Explicit C# type gate passed"
}

main "$@"
